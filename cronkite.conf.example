# cronkite configuration reference.
#
# Copy to /etc/cronkite/cronkite.conf (or ~/.config/cronkite/cronkite.conf) and
# edit. Secrets NEVER belong in this file: they are read from the environment
# variables named here.

version: 1

run:
  # Where cronkite keeps state: locks, reports, the last-run summary.
  # Defaults to the platform state directory for the current user.
  state_dir: ""

  # Any operator-supplied paths are expanded ($VAR, ${VAR} and %VAR%).
  lock_file: ""          # default: <state_dir>/cronkite.lock
  timeout: "30m"         # whole-run deadline

  safety:
    # Hard ceilings for a single run. Exceeding either one aborts the run with
    # exit code 4 instead of deleting. This is what stops a typo from wiping a
    # filesystem; use --force to override deliberately.
    max_delete_files: 500
    max_delete_bytes: "5GiB"

report:
  dir: ""                # default: <state_dir>/reports
  # Individual delete actions stored per task in the JSON report. Counters are
  # always complete; only the action list is capped.
  max_actions_per_task: 1000

notify:
  # Implemented in v0.2.0. Kept in the schema so configurations stay forward
  # compatible.
  enabled: false
  on: [failure, partial]
  throttle: "15m"
  telegram:
    chat_id: ""
    token_env: "CRONKITE_TELEGRAM_TOKEN"

tasks:
  - name: logs
    type: logclean
    roots:
      - /var/log
      - ${HOME}/.local/state/logs
    older_than: 30d
    max_depth: 4
    remove_empty_dirs: true
    protect:
      # Patterns without a separator match the file name; patterns with one
      # match the full path or any trailing part of it, so "cronkite/*" covers
      # /var/log/cronkite today and /srv/apps/cronkite tomorrow. Protecting a
      # directory protects its whole subtree. Both use filepath.Match syntax.
      - "*.journal"
      - "cronkite/*"
      - "wtmp"
      - "btmp"
      - "lastlog"

  - name: temp
    type: tempclean
    roots:
      - /tmp
      - /var/tmp
      - "%TEMP%"
    older_than: 7d
    max_depth: 8
    remove_empty_dirs: true
    protect:
      - ".X11-unix"
      - "systemd-private-*"

  # Incremental, verified backups (v0.2.0). One run writes one complete snapshot
  # and prunes the older ones; unchanged files are hardlinked from the previous
  # snapshot, so a rerun costs no disk. Uncomment, set the paths, and remove the
  # "#" that comments the fields out.
  #
  # - name: data
  #   type: backup
  #   # The trees to back up. One source root per backup task: one snapshot is one
  #   # complete, restorable tree.
  #   roots:
  #     - /srv/app/data
  #   # Where the snapshots live. This is an output path, never a source: it must
  #   # sit outside the roots above, and cronkite only ever writes there and
  #   # removes whole snapshots it wrote itself.
  #   destination: /srv/backups/app
  #   # Keep the newest snapshot of each UTC day for 7 days and of each ISO week
  #   # for 4 weeks; delete the rest. 0 turns a rule off, and 0/0 is refused
  #   # because it keeps nothing.
  #   retention:
  #     daily: 7
  #     weekly: 4
  #   # Share of the snapshot re-hashed against the source after it is written,
  #   # so a run proves it can restore instead of assuming it. At least one file
  #   # is always verified. Default: 10.
  #   verify_sample_percent: 10
  #   # The most one run may copy, in the same size syntax as the run ceilings.
  #   # Bytes relinked from the previous snapshot are not counted: a hardlink
  #   # stores nothing new, so the ceiling bounds what a snapshot adds to the
  #   # disk, not the size of the tree. A run whose plan would copy more is
  #   # refused before anything is written, and `cronkite plan` refuses too, so
  #   # the limit is visible without a run. Raise it deliberately for the first
  #   # snapshot of a large tree. Default: 5GiB.
  #   max_backup_bytes: "5GiB"

  # Your own maintenance script, run inside the same lock and report.
  #
  # The file must be an absolute path to a regular file you wrote: cronkite never
  # downloads or generates a script. It receives CRONKITE_RUN_ID, CRONKITE_MODE,
  # CRONKITE_DRY_RUN and CRONKITE_TASK, and it must honour CRONKITE_DRY_RUN=1 by
  # describing what it would do without changing anything. A non-zero exit is
  # recorded as a task failure and the run continues with the next task.
  #
  # See examples/maintenance.sh and examples/maintenance.ps1.
  # - name: rotate
  #   type: script
  #   interpreter: bash
  #   file: /usr/local/share/cronkite/rotate-app-logs.sh
  #   timeout: 5m
  #   args: ["--keep=14"]
